# Calculadora RTC local (recomendado em produção):
# RTP_CALCULADORA_URL=http://localhost:8080/api
RTP_CALCULADORA_URL=https://consumo.tributos.gov.br/servico/calcular-tributos-consumo/api

# Banco (padrão SQLite em dados/rtp.db). PostgreSQL: postgresql+psycopg://usuario:senha@host/rtp
# RTP_DATABASE_URL=sqlite:///./dados/rtp.db

# Chave que cifra certificados A1 e senhas. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sem ela, uma chave local é criada em dados/chave.key (só para desenvolvimento).
# RTP_CHAVE_CRIPTO=

# Sincronização DF-e automática dentro do servidor web
# RTP_DFE_AGENDADOR=true
# RTP_DFE_INTERVALO_MINUTOS=15

# Login básico da interface web (obrigatório se o servidor for exposto na rede)
# RTP_USUARIO=
# RTP_SENHA=
