# Configuração do RTP no servidor (/opt/rtp/.env, só o usuário rtp lê). Preencha e rode de novo deploy/instalar.sh.

# Banco: o PostgreSQL do projeto RTP no Supabase. Em Project Settings > Database > Connection string, use o
# "Session pooler" (porta 5432). Senha com caracteres especiais vai codificada (ex.: @ vira %40).
RTP_DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Chave que cifra o certificado A1 e as credenciais da Receita guardados no banco: a MESMA do computador de onde o
# banco veio (conteúdo do arquivo dados\chave.key de lá). Sem ela, esses segredos precisam ser cadastrados de novo.
RTP_CHAVE_CRIPTO=

# Calculadora oficial nesta máquina, mantida no ar pelo serviço rtp-calculadora.
RTP_CALCULADORA_URL=http://localhost:8080/api
RTP_CALCULADORA_INICIAR=false

# Endereço público (a API de apuração da Receita chama o webhook nele).
RTP_URL_PUBLICA=https://rtp.suaempresa.com.br
